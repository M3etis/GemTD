{
  "type": "object", "required": ["version", "specials"],
  "properties": {
    "version": { "type": "integer" },
    "specials": { "type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "name_key", "role_key", "silhouette", "color", "damage_type", "targets", "attack", "projectile", "projectile_speed", "recipe", "forge_cost", "value", "levels", "upgrades"],
      "properties": {
        "id": { "type": "string" }, "name_key": { "type": "string" }, "role_key": { "type": "string" },
        "silhouette": { "type": "string" }, "color": { "type": "string" },
        "damage_type": { "type": "string", "enum": ["physical", "pierce", "siege", "fire", "frost", "nature", "arcane", "pure"] },
        "targets": { "type": "string", "enum": ["ground", "both", "air"] },
        "attack": { "type": "string", "enum": ["none", "projectile", "aura_damage", "aura_slow"] },
        "projectile": { "type": "string" }, "projectile_speed": { "type": "number", "minimum": 0 },
        "recipe": { "type": "array", "minItems": 2, "maxItems": 5, "items": {
          "type": "object", "required": ["gem", "quality"],
          "properties": { "gem": { "type": "string" }, "quality": { "type": "integer", "minimum": 1 } } } },
        "forge_cost": { "type": "integer", "minimum": 0 }, "value": { "type": "integer", "minimum": 0 },
        "levels": { "type": "array", "minItems": 3, "maxItems": 3, "items": {
          "type": "object", "required": ["damage", "attack_speed", "range", "effects"],
          "properties": { "damage": { "type": "number", "minimum": 0 }, "attack_speed": { "type": "number", "minimum": 0 },
            "range": { "type": "number", "minimum": 0 }, "effects": { "type": "object" } } } },
        "upgrades": { "type": "array", "minItems": 2, "maxItems": 2, "items": {
          "type": "object", "required": ["level", "gold", "gem", "min_quality"],
          "properties": { "level": { "type": "integer", "minimum": 2, "maximum": 3 }, "gold": { "type": "integer", "minimum": 0 },
            "gem": { "type": "string" }, "min_quality": { "type": "integer", "minimum": 0 } } } }
      }
    } }
  }
}
